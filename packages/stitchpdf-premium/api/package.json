{
  "name": "stitchpdf-premium-api",
  "version": "1.0.0",
  "description": "StitchPDF Premium API - AWS Lambda handlers for premium PDF processing features",
  "main": "handlers/index.js",

  "private": true,
  "scripts": {
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
