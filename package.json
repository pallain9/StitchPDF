{
  "name": "stitchpdf-monorepo",
  "version": "1.0.0",
  "description": "StitchPDF monorepo - open source PDF processing with premium API features",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/stitchpdf",
    "packages/stitchpdf-premium/client"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint packages/*/src/**/*.js",
    "clean": "rm -rf packages/*/node_modules packages/*/dist",
    "dev:public": "npm run start -w packages/stitchpdf",
    "dev:premium": "npm run start -w packages/stitchpdf-premium/client",
    "publish:public": "npm publish -w packages/stitchpdf",
    "publish:premium": "npm publish -w packages/stitchpdf-premium/client",
    "bootstrap": "npm install && npm run build"
  },
  "keywords": [
    "pdf",
    "monorepo",
    "text-extraction",
    "optimization",
    "mail-merge",
    "freemium"
  ],
  "author": "Peter Allain",
  "license": "MIT",
  "homepage": "https://github.com/pallain9/stitchPDF",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pallain9/stitchPDF.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  }
}
