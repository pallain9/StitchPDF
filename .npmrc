# NPM Workspace Configuration
workspaces-update=true
save-exact=true

# Public package registry (for stitchpdf)
@stitchpdf:registry=https://registry.npmjs.org/

# Premium package registry (configure after setting up private registry)
# @stitchpdf:registry=https://your-private-registry.com/

# Publishing configuration
publish-config.access=public 